{
  "name": "dnsi",
  "version": "0.3.0",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "description": "DNSi: Ask an AI a question from any device, on any network, using nothing but DNS.",
  "license": "MIT",
  "homepage": "https://dnsi.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Omodaka9375/DNSi.git"
  },
  "bugs": {
    "url": "https://github.com/Omodaka9375/DNSi/issues"
  },
  "keywords": [
    "dns",
    "llm",
    "ai",
    "cli",
    "nameserver",
    "agents",
    "gethostbyname"
  ],
  "files": [
    "dist",
    "docs",
    "examples",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "start": "tsx src/index.ts",
    "ask": "tsx src/ask-cli.ts",
    "test": "tsx --test test/*.test.ts",
    "verify": "pnpm typecheck && pnpm test",
    "prepublishOnly": "pnpm verify && pnpm build"
  },
  "bin": {
    "dnsi-server": "./dist/index.js",
    "dnsi-ask": "./dist/ask-cli.js"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
