[Unit]
Description=DNSi - question box over DNS
After=network-online.target
Wants=network-online.target

[Service]
User=dnsi
WorkingDirectory=/opt/dnsi
Environment=DNSI_PORT=53
Environment=DNSI_ZONE=dnsi.dev
Environment=DNSI_ANSWERS=/opt/dnsi/examples/answers.json
Environment=DNSI_STATS=1
Environment=DNSI_DOH_PORT=443
Environment=DNSI_DOT_PORT=853
Environment=DNSI_TLS_CERT=/etc/dnsi/certs/certificates/ns.dnsi.dev.crt
Environment=DNSI_TLS_KEY=/etc/dnsi/certs/certificates/ns.dnsi.dev.key
ExecStart=/usr/bin/node /opt/dnsi/dist/index.js
Restart=always
RestartSec=3
# bind 53/443/853 without running as root
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
